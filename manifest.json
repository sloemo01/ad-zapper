{
  "manifest_version": 3,
  "name": "Ad Zapper",
  "version": "2.7.40",
  "description": "Blocks ads and trackers on every page from the real filter lists, strips YouTube ad breaks out of the player data, kills popunder windows and ad loaders, hides ad slots everywhere, and rewrites ad-block walls before they render.",
  "minimum_chrome_version": "111",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "scripting",
    "debugger",
    "alarms",
    "webNavigation",
    "nativeMessaging"
  ],
  "host_permissions": [
    "*://*/*",
    "*://*.youtube.com/*",
    "*://*.youtube-nocookie.com/*",
    "*://*.youtubekids.com/*",
    "https://easylist.to/*",
    "https://raw.githubusercontent.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Ad Zapper",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "dnr_walled",
        "enabled": true,
        "path": "rules/dnr_walled.json"
      },
      {
        "id": "youtube_ads",
        "enabled": true,
        "path": "rules.json"
      },
      {
        "id": "dnr_1",
        "enabled": true,
        "path": "rules/dnr_1.json"
      },
      {
        "id": "dnr_2",
        "enabled": true,
        "path": "rules/dnr_2.json"
      },
      {
        "id": "dnr_3",
        "enabled": true,
        "path": "rules/dnr_3.json"
      },
      {
        "id": "dnr_4",
        "enabled": true,
        "path": "rules/dnr_4.json"
      },
      {
        "id": "dnr_5",
        "enabled": true,
        "path": "rules/dnr_5.json"
      },
      {
        "id": "dnr_6",
        "enabled": true,
        "path": "rules/dnr_6.json"
      },
      {
        "id": "dnr_7",
        "enabled": true,
        "path": "rules/dnr_7.json"
      },
      {
        "id": "dnr_8",
        "enabled": true,
        "path": "rules/dnr_8.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*",
        "*://*.youtubekids.com/*"
      ],
      "js": [
        "src/inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/skip-hosts.js",
        "src/wall-hosts.js",
        "src/wall-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "exclude_matches": [
        "*://github.com/*",
        "*://*.github.com/*",
        "*://githubusercontent.com/*",
        "*://*.githubusercontent.com/*",
        "*://gitlab.com/*",
        "*://*.gitlab.com/*",
        "*://stackoverflow.com/*",
        "*://*.stackoverflow.com/*",
        "*://npmjs.com/*",
        "*://*.npmjs.com/*",
        "*://localhost/*",
        "*://127.0.0.1/*"
      ]
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*",
        "*://*.youtubekids.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/skip-hosts.js",
        "src/popup-hosts.js",
        "src/popups.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "exclude_matches": [
        "*://github.com/*",
        "*://*.github.com/*",
        "*://githubusercontent.com/*",
        "*://*.githubusercontent.com/*",
        "*://gitlab.com/*",
        "*://*.gitlab.com/*",
        "*://stackoverflow.com/*",
        "*://*.stackoverflow.com/*",
        "*://npmjs.com/*",
        "*://*.npmjs.com/*",
        "*://localhost/*",
        "*://127.0.0.1/*"
      ]
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/skip-hosts.js",
        "src/wall-hosts.js",
        "src/wall-guard.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "exclude_matches": [
        "*://github.com/*",
        "*://*.github.com/*",
        "*://githubusercontent.com/*",
        "*://*.githubusercontent.com/*",
        "*://gitlab.com/*",
        "*://*.gitlab.com/*",
        "*://stackoverflow.com/*",
        "*://*.stackoverflow.com/*",
        "*://npmjs.com/*",
        "*://*.npmjs.com/*",
        "*://localhost/*",
        "*://127.0.0.1/*"
      ]
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/skip-hosts.js",
        "src/wall-hosts.js",
        "src/scriptlet-map.js",
        "src/scriptlets.js",
        "src/relay.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "exclude_matches": [
        "*://github.com/*",
        "*://*.github.com/*",
        "*://githubusercontent.com/*",
        "*://*.githubusercontent.com/*",
        "*://gitlab.com/*",
        "*://*.gitlab.com/*",
        "*://stackoverflow.com/*",
        "*://*.stackoverflow.com/*",
        "*://npmjs.com/*",
        "*://*.npmjs.com/*",
        "*://localhost/*",
        "*://127.0.0.1/*"
      ]
    }
  ]
}
